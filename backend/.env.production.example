APP_NAME=adyabd-web
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.bazar.com.bd
FRONTEND_URL=https://bazar.com.bd

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bazar_db
DB_USERNAME=bazar_user
DB_PASSWORD=your_strong_password

CACHE_DRIVER=redis
# database = jobs are processed by the scheduler (just add the one cron line, no separate worker).
# Use "sync" for local development (jobs run immediately).
QUEUE_CONNECTION=database
SESSION_DRIVER=redis
FILESYSTEM_DISK=public

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@bazar.com.bd
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@bazar.com.bd
MAIL_FROM_NAME="বাজার"

# SMS Gateway (BD Local)
SMS_GATEWAY=ssl_wireless
SMS_API_URL=https://sms.sslwireless.com/api/v3/send-sms
SMS_API_TOKEN=
SMS_SID=
SMS_DEFAULT_SENDER=BazarBD
BULK_SMS_URL=https://bulksmsbd.net/api/smsapi
BULK_SMS_API_KEY=
BULK_SMS_SENDER_ID=BazarBD

# ZiniPay Payment
ZINIPAY_API_KEY=
ZINIPAY_BASE_URL=https://api.zinipay.com

# SteadFast Courier
STEADFAST_API_KEY=
STEADFAST_API_SECRET=

# Pathao Courier
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=

# Redx Courier
REDX_API_TOKEN=

# Paperfly Courier
PAPERFLY_API_KEY=

# Sundarban Courier
SUNDARBAN_API_KEY=

# Firebase Push Notifications
FIREBASE_SERVER_KEY=
FIREBASE_PROJECT_ID=

# Initial admin (seeder). Leave password empty to auto-generate one.
ADMIN_SEED_EMAIL=admin@bazar.com.bd
ADMIN_SEED_PASSWORD=

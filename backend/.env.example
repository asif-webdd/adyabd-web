# ── Local development defaults (setup.sh/setup.ps1 copy this to .env for you) ──
# For a live server use .env.production.example instead.
APP_NAME=adyabd-web
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Option A (zero setup): SQLite. Create the file once:  touch database/database.sqlite
DB_CONNECTION=sqlite
# Option B: MySQL (XAMPP / Laragon) – comment the line above and use these:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=adyabd_web_db
# DB_USERNAME=root
# DB_PASSWORD=

# No Redis needed locally
CACHE_STORE=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
FILESYSTEM_DISK=public
MAIL_MAILER=log
LOG_CHANNEL=single

# Initial admin login for http://localhost:8000/admin
ADMIN_SEED_EMAIL=admin@bazar.com.bd
ADMIN_SEED_PASSWORD=Admin@12345

# Optional (leave empty to skip): ZINIPAY_API_KEY= , SMS tokens, courier keys

# Google login (optional): OAuth Web client ID from Google Cloud Console
GOOGLE_CLIENT_ID=
# Facebook login (optional): App ID + App Secret from developers.facebook.com (also set NUXT_PUBLIC_FACEBOOK_APP_ID in frontend/.env)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
